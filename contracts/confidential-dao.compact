pragma language_version >= 0.23;

import CompactStandardLibrary;

// ─── Public ledger state — visible on the Midnight blockchain ───
export ledger proposalId: Uint<64>;
export ledger title: Opaque<"string">;
export ledger yesVotes: Uint<64>;
export ledger noVotes: Uint<64>;
export ledger voterCount: Uint<64>;
export ledger isFinalized: Boolean;

// ─── Private witness input ───
// secretVoteChoice is a PRIVATE ZK witness — computed locally by the voter,
// never transmitted to any node, indexer, or observer on the Midnight Network.
// The ZK circuit proves vote validity without revealing the actual choice.
witness secretVoteChoice(): Boolean;

// ─── Circuit: Initialize a new DAO proposal ───
export circuit createProposal(initialTitle: Opaque<"string">): [] {
    proposalId = (proposalId + 1) as Uint<64>;
    title = disclose(initialTitle);
    yesVotes = 0 as Uint<64>;
    noVotes = 0 as Uint<64>;
    voterCount = 0 as Uint<64>;
    isFinalized = false;
}

// ─── Circuit: Confidential ZK vote using private witness ───
// The vote choice comes from the private witness (never a public argument).
// Only the aggregate tally is updated via disclose() — individual choice is hidden.
export circuit castVote(): [] {
    assert(!isFinalized, "Voting has been finalized");
    const voteChoice = secretVoteChoice();
    voterCount = (voterCount + 1) as Uint<64>;

    if (disclose(voteChoice)) {
        yesVotes = (yesVotes + 1) as Uint<64>;
    } else {
        noVotes = (noVotes + 1) as Uint<64>;
    }
}

// ─── Circuit: Finalize and lock proposal voting ───
export circuit finalizeProposal(): [] {
    assert(!isFinalized, "Proposal is already finalized");
    isFinalized = true;
}
